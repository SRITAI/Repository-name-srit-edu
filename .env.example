# Postgres connection (only needed if you run raw SQL/migrations outside Supabase CLI)
DATABASE_URL=

# Supabase — the URL and anon key are read in the browser, so Next.js
# requires the NEXT_PUBLIC_ prefix on those two specifically. The service
# role key must NEVER get that prefix — it stays server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay — KEY_ID is safe on the client (Checkout needs it), the other
# two must stay server-only.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Session/auth secret
AUTH_SECRET=

# Used to build the password-reset link Supabase emails to students.
# Set to your deployed URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
