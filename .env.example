# ==============================================================================
# INFIMINDSS "Human + AI" Brand Video Studio — Environment Variables
# ==============================================================================

# 1. Supabase (Required for Database, Auth & Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Meta Graph API (Optional — for Instagram oEmbed auto-metadata)
# Meta App ID & Client Token from developer.facebook.com
META_APP_ID=your-meta-app-id
META_CLIENT_TOKEN=your-meta-client-token

# 3. Meta Pixel & Conversions API (CAPI)
NEXT_PUBLIC_META_PIXEL_ID=your-meta-pixel-id
META_CAPI_ACCESS_TOKEN=your-meta-conversions-api-token

# 4. Anthropic API (Optional — for "Draft a script for me" from product images)
ANTHROPIC_API_KEY=your-anthropic-api-key

# 5. Google Drive API (Optional — for verifying Drive link accessibility)
GOOGLE_API_KEY=your-google-api-key

# 6. Site URL (For Canonical links, sitemap & OAuth redirects)
NEXT_PUBLIC_SITE_URL=https://repository-name-srit-edu-y5zm-3d3be2jep-srit4.vercel.app
