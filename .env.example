NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: Supabase secret key (sb_secret_...) or existing legacy service_role JWT.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-only: enabled only after configuring the Google provider in Supabase.
GOOGLE_AUTH_ENABLED=false
# Optional ClamAV INSTREAM-compatible HTTP scanning gateway. Fail closed when configured.
MEDIA_SCAN_URL=
MEDIA_SCAN_TOKEN=
MAX_IMAGE_MB=10
MAX_VIDEO_MB=50
# Explicitly isolated fictional browser-session preview.
NEXT_PUBLIC_ENABLE_PREVIEW=true
