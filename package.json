{
  "name": "sritedu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src scripts tests *.ts *.mjs *.json README.md",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:security": "node --import tsx tests/security.ts",
    "db:start": "supabase start -x studio,imgproxy,edge-runtime,logflare,vector,supavisor",
    "db:reset": "supabase db reset",
    "admin": "tsx scripts/admin.ts",
    "cleanup": "tsx scripts/cleanup.ts",
    "test:live": "node --env-file-if-exists=.env.live.local scripts/verify-live.mjs",
    "review:screenshots": "node scripts/capture-review.mjs"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "clsx": "^2.1.1",
    "file-type": "^21.3.4",
    "lucide-react": "^0.577.0",
    "motion": "^12.34.3",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.3",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "supabase": "^2.78.1",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
